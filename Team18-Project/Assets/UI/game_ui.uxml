<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ui_style_sheet.uss?fileID=7433441132597879392&amp;guid=556a3f93f1ebc3440b6a3ab2247b7eea&amp;type=3#ui_style_sheet" />
    <ui:VisualElement style="flex-grow: 1; justify-content: center;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 0; flex-basis: 30%; justify-content: space-between; padding-top: 200px;">
                <ui:VisualElement style="flex-grow: 1; justify-content: center;">
                    <ui:Label text="Eye Chance: 99%" name="ChanceOfEye" style="font-size: 60px; white-space: normal; -unity-text-align: middle-center;" />
                    <ui:VisualElement name="Dice" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Assets/Dice%20Spritesheet%20copy.png?fileID=-8771915625222027849&amp;guid=a2af03da0426a12438a5175ce3f07e53&amp;type=3#Dice Spritesheet copy_2&quot;); -unity-background-scale-mode: scale-to-fit; flex-basis: 30%;" />
                </ui:VisualElement>
                <ui:VisualElement name="PlayerHealthContainer" style="flex-grow: 0; flex-direction: row; flex-basis: auto; align-content: flex-start; justify-content: flex-start; align-self: stretch; padding-left: 25px; align-items: flex-start; height: auto; width: auto;">
                    <ui:VisualElement name="PlayerHeartImage" enabled="true" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Assets/Healthbar%20Spritesheet%20copy.png?fileID=-7469671084087019599&amp;guid=acfd1d6a650f9b642a5c9ba2edb04f12&amp;type=3#Healthbar Spritesheet copy_12&quot;); -unity-background-scale-mode: scale-to-fit; flex-basis: 75px; background-size: contain; align-items: flex-start; align-self: center; justify-content: flex-start; height: 75px; width: 75px; padding-left: 0;" />
                    <ui:ProgressBar value="22" name="PlayerHealthBar" style="align-self: center; align-content: center; flex-grow: 1; height: 50px; align-items: stretch; justify-content: center; background-image: url(&quot;project://database/Assets/Assets/Healthbar%20Spritesheet%20copy.png?fileID=5866449069182397180&amp;guid=acfd1d6a650f9b642a5c9ba2edb04f12&amp;type=3#Healthbar Spritesheet copy_15&quot;);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Cyclops" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Assets/Cyclops.png?fileID=4809396141046213086&amp;guid=75d5e11c3fea18a4f90d136fd0e6a408&amp;type=3#Base_Cyclops1&quot;); -unity-background-scale-mode: scale-to-fit; flex-basis: 40%;">
                <ui:VisualElement name="CyclopsHealthContainer" style="flex-grow: 0; flex-direction: row; flex-basis: auto; align-content: flex-start; justify-content: flex-start; align-self: stretch; padding-left: 0; align-items: flex-start; height: auto; width: auto;">
                    <ui:VisualElement name="CyclopsEyeImage" enabled="true" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Assets/Eye%20indicator%20copy.png?fileID=-9150038586942285270&amp;guid=5fb3b86586bd20f49930e5b06c717db5&amp;type=3#Eye indicator copy_1&quot;); -unity-background-scale-mode: scale-to-fit; flex-basis: 75px; background-size: contain; align-items: flex-start; align-self: center; justify-content: flex-start; height: 75px; width: 75px; padding-left: 0;" />
                    <ui:ProgressBar value="22" name="CyclopsHealthBar" style="align-self: center; align-content: center; flex-grow: 1; height: 50px; align-items: stretch; justify-content: center; background-image: url(&quot;project://database/Assets/Assets/Healthbar%20Spritesheet%20copy.png?fileID=4828490999120485722&amp;guid=acfd1d6a650f9b642a5c9ba2edb04f12&amp;type=3#Healthbar Spritesheet copy_17&quot;);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="TextButton" style="rotate: 0; -unity-background-scale-mode: stretch-to-fill; flex-grow: 0; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); flex-basis: 30%;" />
        </ui:VisualElement>
        <ui:VisualElement name="ButtonContainer" style="flex-grow: 0; flex-basis: 250px; align-items: center; justify-content: space-evenly; flex-direction: row; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:Button text="Attack" name="AttackButton" class="button" style="background-color: rgb(255, 128, 128);" />
            <ui:Button text="Block" name="BlockButton" class="button" style="background-color: rgb(128, 128, 255);" />
            <ui:Button text="Heal" name="HealButton" class="button" style="background-color: rgb(128, 255, 128);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
